# Telegram user API credentials from https://my.telegram.org.
# These can instead be entered in the Android gear menu; app-saved values override this file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram

# These can also be entered in the Android gear menu and are saved only by the local backend.
# When using a remote backend, send secrets over HTTPS and protect the settings API.
# GapGPT's dashboard/API documentation is the source of truth for this URL.
GAPGPT_BASE_URL=
GAPGPT_API_KEY=
GAPGPT_MODEL=
GAPGPT_VISION_MODEL=
AI_ENABLE_VISION=false
AI_TIMEOUT_SECONDS=45
NOTIFY_ONLY_WITH_PRICE=true

# Optional: set this to 0 while configuring the app without Telegram credentials.
START_TELEGRAM=true

DATABASE_PATH=data/app.db
MEDIA_DIR=data/media
